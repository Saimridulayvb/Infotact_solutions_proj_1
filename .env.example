# ==============================================================================
# AtmoGraph Environment Configuration Template
# Copy this file to .env and configure local or remote Neo4j connection parameters
# ==============================================================================

# Neo4j Connection Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# Pipeline Configuration
ATMOGRAPH_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
OUTPUT_GRAPH_DIR=data/processed/graph

# Company Selection Thresholds
TOP_COMPANIES_LIMIT=20
MIN_CONNECTED_INPUTS=1
